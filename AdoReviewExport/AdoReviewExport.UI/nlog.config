<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <variable name="logDir" value="${specialfolder:folder=TemporaryFileDir}/AdoReviewExport/logs" />

  <targets>
    <target xsi:type="File"
            name="file"
            fileName="${logDir}/app-${shortdate}.log"
            archiveEvery="Day"
            maxArchiveFiles="7"
            concurrentWrites="true"
            keepFileOpen="false">
      <layout xsi:type="JsonLayout" includeAllProperties="true">
        <attribute name="timestamp" layout="${date:format=o}" />
        <attribute name="level" layout="${level}" />
        <attribute name="logger" layout="${logger}" />

        <!-- PAT/Authorization masking (best-effort) -->
        <attribute name="message" layout="${replace:regex=true:searchFor=(?i)(Authorization:\\s*Basic\\s+)[A-Za-z0-9+/=]+:replacement=$1***REDACTED***:${message}}" />
        <attribute name="exception" layout="${replace:regex=true:searchFor=(?i)(Authorization:\\s*Basic\\s+)[A-Za-z0-9+/=]+:replacement=$1***REDACTED***:${exception:format=ToString}}" />
      </layout>
    </target>
  </targets>

  <rules>
    <logger name="*" minlevel="Info" writeTo="file" />
  </rules>
</nlog>
