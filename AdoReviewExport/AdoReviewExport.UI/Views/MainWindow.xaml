<Window
    x:Class="AdoReviewExport.UI.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="AdoReviewExport">

    <Grid x:Name="Root" Padding="24" RowSpacing="16" ColumnSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Azure DevOps Review Exporter" FontSize="24" FontWeight="SemiBold" />

        <Grid Grid.Row="1" ColumnSpacing="12" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Organization" VerticalAlignment="Center" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Organization, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="contoso または http://localhost" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Project" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Project, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="MyProject" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Repository" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Repository, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="my-repo" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="PAT" VerticalAlignment="Center" />
            <PasswordBox Grid.Row="3" Grid.Column="1" Password="{Binding PersonalAccessToken, Mode=TwoWay}" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Output Path" VerticalAlignment="Center" />
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding OutputFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Row="4" Grid.Column="2" Content="📁" Click="OnBrowseClick" />

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Authors (Optional)" VerticalAlignment="Center" />
            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Authors, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="alice,bob" />
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="12" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Grid.Column="0" Content="Start Export" Command="{Binding StartExportCommand}" />
            <Button Grid.Row="0" Grid.Column="1" Content="Cancel" Command="{Binding CancelCommand}" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding StatusText}" VerticalAlignment="Center" />

            <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Minimum="0" Maximum="{Binding ProgressMaximum}" Value="{Binding ProgressValue}" Height="12" />
        </Grid>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Log" FontWeight="SemiBold" Margin="0,8,0,0" />
            <ListView Grid.Row="1" ItemsSource="{Binding Logs}" />
        </Grid>
    </Grid>
</Window>
